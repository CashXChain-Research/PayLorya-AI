{
  "name": "cxc-agentpay",
  "version": "0.1.0",
  "private": true,
  "description": "CxC Payment Readiness API: pay-per-request validation for autonomous payment agents, settled via x402 on Cardano Preprod.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "extract": "tsx --env-file-if-exists=.env scripts/extract-demo.ts",
    "wallet:new": "tsx scripts/new-wallet.ts",
    "preflight": "tsx --env-file-if-exists=.env scripts/preflight.ts",
    "smoke:x402": "tsx --env-file-if-exists=.env scripts/smoke-x402.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@scure/bip39": "^2.4.0",
    "@x402/cardano": "^2.29.0",
    "@x402/core": "^2.29.0",
    "@x402/express": "^2.29.0",
    "@x402/fetch": "^2.29.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0"
  }
}
