{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cxc-agentpay",
  // CashXChain account; pinned so a login with several accounts cannot deploy elsewhere.
  "account_id": "755009eab613c24e1d604d857042601c",
  "main": "cloudflare/worker.ts",
  // Static files (HTML, CSS, JS, fonts, images) are served by Cloudflare's edge, near the visitor,
  // without waking or waiting for the container. Everything that is not a file in public/ goes to
  // the Worker and on to the container. The paths below always go to the Worker first: /app needs
  // the server's login redirect although public/app.html exists; the others are API routes (/mcp:
  // the MCP server; /oauth/*, /authorize, /token, /register, /revoke, /.well-known/*: its OAuth sign-in).
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    "run_worker_first": ["/api/*", "/app", "/app/*", "/health", "/v1/*", "/facilitator/*", "/mcp", "/oauth/*", "/authorize", "/token", "/register", "/revoke", "/.well-known/*"]
  },
  "compatibility_date": "2026-10-01",
  "containers": [
    {
      "class_name": "AgentPayContainer",
      "image": "./Dockerfile",
      // Default is "lite" (256 MiB). The app idles at ~165 MiB before a payment, so use 1 GiB.
      "instance_type": "basic",
      "max_instances": 1,
      // Run next to D1 (primary Western Europe) and the users. Without this the container starts
      // wherever the first request after a deploy comes from (e.g. the US) and every page and every
      // database query crosses the Atlantic.
      "constraints": { "regions": ["WEUR"] }
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "AgentPayContainer", "name": "AGENTPAY" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AgentPayContainer"] }],
  // AI CFO data, reached by the container through the outbound handler in cloudflare/worker.ts.
  "d1_databases": [{ "binding": "CFO_DB", "database_name": "cxc-ai-cfo", "database_id": "86dd0418-3689-413f-8b1b-ccb77bc2b87e" }],
  "r2_buckets": [{ "binding": "CFO_FILES", "bucket_name": "cxc-ai-cfo-documents" }],
  "observability": { "enabled": true },
  // Variables set in the dashboard (e.g. CLAUDE_MODEL) survive deploys. The ones listed under "vars"
  // below are still set from this file on every deploy; change those here.
  "keep_vars": true,
  // Non-secret config, applied on every deploy.
  // Secrets (never here): ANTHROPIC_API_KEY, BLOCKFROST_PROJECT_ID, BUYER_MNEMONIC, SELLER_ADDRESS, CASHXCHAIN_API_KEY,
  // RESEND_API_KEY
  // via `npx wrangler secret put <NAME>`. See docs/DEPLOY.md.
  "vars": {
    "PUBLIC_BASE_URL": "https://paylorya.valentin.is",
    "AUTH_TRUSTED_ORIGINS": "https://cxc-agentpay.cashxchain.workers.dev",
    // Served by the Worker's outbound handler (D1 + R2); unset locally, where SQLite and a folder are used.
    "CFO_DATA_URL": "http://cfo-data.internal",
    "LOCAL_FACILITATOR": "false",
    // A8: settle once the tx is in a block, no extra depth (testnet). With 1, the hosted facilitator's
    // settle took 32 s once and ran into an nginx 504 after ~65 s once. Its advertised range is [0, 20].
    "CARDANO_L1_CONFIRMATIONS": "0",
    "PRICE_LOVELACE": "2000000",
    "MAX_PRICE_LOVELACE": "3000000",
    "SESSION_BUDGET_LOVELACE": "20000000",
    "MAX_PAYMENTS_PER_RUN": "1",
    "SUPPLIER_CARDANO_ADDRESS": "addr_test1qqsqefsjjl242gt2zjqu5nygp58rjuqn0f0nncrfn4n6mpf5dg8fzcj9pw62y9rk972sc7u959up5gwnm4tz6zcqzlxsazp9p0"
  }
}
