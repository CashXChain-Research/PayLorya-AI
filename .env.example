# Copy to .env. Test-only values. Never commit .env.

PORT=8787
# Public URL when deployed (used by the buyer agent to reach the seller endpoint)
# PUBLIC_BASE_URL=https://cxc-agentpay.<your-subdomain>.workers.dev

# --- Cardano Preprod / x402 ---------------------------------------------
BLOCKFROST_PREPROD_URL=https://cardano-preprod.blockfrost.io/api/v0
BLOCKFROST_PROJECT_ID=
# npm run wallet:new -- seller  -> only the address goes here
SELLER_ADDRESS=
# npm run wallet:new -- buyer   -> fund the printed address via the preprod faucet
BUYER_MNEMONIC=

# Hosted Cardano Foundation preprod facilitator (documented on developers.cardano.org; verify live first)
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org
# true = use the in-process fallback facilitator at /facilitator (needs Blockfrost)
LOCAL_FACILITATOR=false
# Optional: -1 mempool (needs LOCAL_FACILITATOR), 0 block inclusion, 1..20 confirmations. Spec default is 1.
# CARDANO_L1_CONFIRMATIONS=
EXPLORER_TX_URL=https://preprod.cardanoscan.io/transaction/

# --- Pricing and buyer spend policy (lovelace; 1 tADA = 1000000) ---------
PRICE_LOVELACE=2000000
MAX_PRICE_LOVELACE=3000000
SESSION_BUDGET_LOVELACE=20000000
MAX_PAYMENTS_PER_RUN=1
DEMO_AMOUNT_CEILING_MINOR=5000000

# --- Invoice payouts (after human approval) -------------------------------
# Verified wallet of the demo crypto payee (npm run wallet:new -- supplier). Without it the
# Cardano payout route is unavailable; fiat invoices still route to the CashXChain adapter.
SUPPLIER_CARDANO_ADDRESS=
PAYOUT_MAX_LOVELACE=10000000
PAYOUT_BUDGET_LOVELACE=30000000

# --- CashXChain fiat payouts (sandbox only) ---------------------------------
# Optional. cxc_sk_sandbox_... or cxc_rk_sandbox_...; live keys are refused at startup.
# Unset: approved fiat invoices use the simulated stand-in. See docs/DEPLOY.md.
CASHXCHAIN_API_KEY=

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Optional Cloudflare AI Gateway: https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/anthropic
# ANTHROPIC_BASE_URL=
CLAUDE_MODEL=claude-opus-5-5
